{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/tools/vci_snapshot.py\" \"${CLAUDE_PROJECT_DIR}\" --check",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
